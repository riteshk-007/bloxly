generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String
  posts     Post[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // User relationship - categories are user-specific
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([name, userId]) // Unique category name per user
  @@unique([slug, userId]) // Unique category slug per user
}

model Tag {
  id        String   @id @default(cuid())
  name      String
  slug      String
  posts     Post[]
  createdAt DateTime @default(now())

  // User relationship - tags are user-specific
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([name, userId]) // Unique tag name per user
  @@unique([slug, userId]) // Unique tag slug per user
}

model Post {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  excerpt         String?
  content         String    @db.Text
  featuredImage   String?
  images          String[]
  status          Status    @default(DRAFT)
  metaTitle       String?
  metaDescription String?
  keywords        String[]
  author          String    @default("Admin")
  views           Int       @default(0)
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  tags       Tag[]

  // Domain relationship
  domainId String?
  domain   Domain? @relation(fields: [domainId], references: [id])

  @@index([slug])
  @@index([status])
  @@index([publishedAt])
  @@index([domainId])
}

enum Status {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// User Management
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  image     String?
  password  String? // For admin login
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  domains      Domain[]
  subscription Subscription?
  sessions     Session[]
  accounts     Account[]
  images       Image[]
  categories   Category[]
  tags         Tag[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Role {
  USER
  ADMIN
}

// Domain & Subscription Management
model Domain {
  id          String   @id @default(cuid())
  domain      String   @unique
  apiKey      String   @unique
  isActive    Boolean  @default(true)
  rateLimit   Int      @default(100) // Per hour
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  userId   String
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts    Post[]
  requests ApiRequest[]
  images   Image[]

  @@index([userId])
  @@index([isActive])
}

model Subscription {
  id                String    @id @default(cuid())
  userId            String    @unique
  planType          PlanType  @default(FREE)
  status            SubStatus @default(ACTIVE)
  domainsAllowed    Int       @default(1)
  blogsPerDomain    Int       @default(5)
  currentDomains    Int       @default(0)
  startDate         DateTime  @default(now())
  endDate           DateTime
  razorpayOrderId   String?
  razorpayPaymentId String?
  amount            Float?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([endDate])
}

enum PlanType {
  FREE // 1 domain, 5 blogs
  PAID_MONTHLY // 3 domains, 20 blogs each, ₹49/month
  CUSTOM_30DAYS // 30 days, 30 blogs
}

enum SubStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

model ApiRequest {
  id        String   @id @default(cuid())
  domainId  String
  domain    Domain   @relation(fields: [domainId], references: [id])
  endpoint  String
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([domainId, createdAt])
}

model Image {
  id           String   @id @default(cuid())
  url          String
  key          String   @unique
  originalName String
  size         Int
  mimeType     String
  userId       String
  domainId     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([domainId])
}
